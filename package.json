{
  "name": "elder-entrustment",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.23.4"
  },
  "scripts": {
    "start": "node src/main.mjs",
    "start:partner": "node support/peer.mjs",
    "scenario": "node scripts/scenario.mjs",
    "build": "for f in src/*.mjs support/peer.mjs scripts/scenario.mjs tests/*.test.mjs; do node --check \"$f\" || exit 1; done",
    "test": "node --test tests/*.test.mjs"
  }
}
